    {
      "id": "p1",
      "name": "Parse Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4000,
        340
      ],
      "parameters": {
        "jsCode": "const b = $input.first().json;\nconst req = $('Build Request').first().json;\nconst out = b.output || [];\nconst msg = out.find(o => o.type === 'message');\nlet text = msg?.content?.find(c => c.type === 'output_text')?.text || '';\ntext = text.replace(/\\*\\*/g, '').replace(/[ \\t]+([.,;:!?])/g, '$1').trim();\nif (req.kind === 'voice' && req.transcript && text) text = '🎙️ \"' + req.transcript + '\"\\n\\n' + text;\ntext = text.slice(0, 4000);\nconst sources = [...new Set(out.filter(o => o.type === 'file_search_call').flatMap(o => (o.results || []).map(r => r.filename)).concat((msg?.content?.[0]?.annotations || []).map(a => a.filename)).filter(Boolean))].join(', ');\nreturn [{ json: { ok: !!text && !b.error, text, responseId: b.id || '', error: b.error ? JSON.stringify(b.error) : '', sources, secs: (b.completed_at && b.created_at) ? b.completed_at - b.created_at : null, chatId: req.chatId, userName: req.userName, userText: req.userText } }];"
      }
