    {
      "id": "pm1",
      "name": "Parse Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        340
      ],
      "parameters": {
        "jsCode": "// Normalises the incoming Telegram message. If the user REPLIES to a photo/voice without attaching one, use the replied media.\nconst m = $('Telegram Trigger').first().json.message;\nconst pick = (x) => {\n  if (!x) return null;\n  if (x.voice) return { kind: 'voice', fileId: x.voice.file_id };\n  if (x.audio) return { kind: 'voice', fileId: x.audio.file_id };\n  if (x.photo?.length) return { kind: 'image', fileId: x.photo[x.photo.length - 1].file_id };\n  if (x.document && /^image\\//.test(x.document.mime_type || '')) return { kind: 'image', fileId: x.document.file_id };\n  if (x.video || x.video_note || x.sticker || x.animation || x.document) return { kind: 'unsupported', fileId: '' };\n  return null;\n};\nlet media = pick(m);\nif (!media && m.reply_to_message) {\n  const r = pick(m.reply_to_message);\n  if (r && r.kind !== 'unsupported') media = r;\n}\nmedia = media || { kind: 'text', fileId: '' };\nreturn [{ json: { chatId: String(m.chat.id), messageId: m.message_id, kind: media.kind, fileId: media.fileId || '', text: (m.text || m.caption || '').trim() } }];"
      }
    },
