    {
      "id": "b1",
      "name": "Build Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3560,
        340
      ],
      "parameters": {
        "jsCode": "// System prompt comes from /files/manuel-config/system_prompt.md via Read Prompt -> Detect Media\n// (host: /var/www/n8n-shared/manuel-config/system_prompt.md)\nconst d = $('Detect Media').first().json;\nconst SP = d.SP;\nconst VS = 'vs_6ac368acbc64819186fb0a0b0b2e3864';\nconst SESSION_TTL_MS = 2 * 3600 * 1000; // conversation memory expires after 2h idle\nconst msg = $('Telegram Trigger').first().json.message;\nconst caption = ($('Combine').first().json.text || '').trim();\nconst content = [];\nlet userText, logText, transcript = '';\nif (d.kind === 'voice') {\n  transcript = ($input.first().json.text || '').trim();\n  userText = transcript ? '[Voice note transcript] ' + transcript : '[The user sent a voice note but it could not be transcribed. Ask them to repeat it or type it.]';\n  logText = '[voice] ' + transcript;\n} else if (d.kind === 'image') {\n  const bin = $input.first().binary?.data;\n  const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n  const mime = (bin?.mimeType || '').startsWith('image/') ? bin.mimeType : 'image/jpeg';\n  content.push({ type: 'input_image', image_url: 'data:' + mime + ';base64,' + buf.toString('base64'), detail: 'auto' });\n  userText = caption || '[The user sent a photo without any text.]';\n  logText = '[photo] ' + caption;\n} else if (d.kind === 'unsupported') {\n  userText = '[The user sent a video, sticker or file you cannot open. Ask for a photo or a short description instead.]' + (caption ? ' Caption: ' + caption : '');\n  logText = '[unsupported media] ' + caption;\n} else {\n  userText = caption || '[Empty message]';\n  logText = userText;\n}\ncontent.unshift({ type: 'input_text', text: userText });\nconst sess = $('Get Session').first().json;\nconst fresh = sess.lastActivity && (Date.now() - new Date(sess.lastActivity).getTime()) < SESSION_TTL_MS;\nconst name = msg.from?.first_name || '';\nconst payload = {\n  model: 'gpt-5.5',\n  instructions: SP + '\\n\\n# Current user\\nFirst name: ' + name,\n  input: [{ role: 'user', content }],\n  tools: [{ type: 'file_search', vector_store_ids: [VS], max_num_results: 6 }],\n  reasoning: { effort: 'low' },\n  truncation: 'auto',\n  store: true,\n  include: ['file_search_call.results']\n};\nif (fresh && String(sess.responseId || '').startsWith('resp_')) payload.previous_response_id = sess.responseId;\nreturn [{ json: { payload, userText: logText, transcript, kind: d.kind, chatId: String(msg.chat.id), userName: name } }];"
      }
    },
