      "parameters": {
        "jsCode": "// Telegram voice notes are .oga (ogg/opus); OpenAI needs a supported extension\nconst it = $input.first();\nit.binary.data.fileName = 'voice.ogg';\nit.binary.data.mimeType = 'audio/ogg';\nit.binary.data.fileExtension = 'ogg';\nreturn [it];"
