    {
      "id": "cb1",
      "name": "Combine",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        340
      ],
      "parameters": {
        "jsCode": "// Telegram sends 'forward with comment' and albums as separate updates arriving together.\n// Every message waits ~3s; only the execution holding the newest message answers, with everything combined.\nconst me = $('Parse Message').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.messageId !== undefined && r.messageId !== null && r.chatId === me.chatId);\nconst mine = rows.some(r => Number(r.messageId) === Number(me.messageId));\nlet group;\nif (!mine) {\n  group = [me]; // our pending row was already consumed/cleared: answer this message on its own\n} else {\n  const maxId = Math.max(...rows.map(r => Number(r.messageId)));\n  if (Number(me.messageId) !== maxId) return []; // a newer message from this chat will answer for all\n  group = rows.sort((a, b) => Number(a.messageId) - Number(b.messageId));\n}\nconst text = group.map(r => (r.text || '').trim()).filter(Boolean).join('\\n');\nconst img = group.find(r => r.kind === 'image');\nconst voice = group.find(r => r.kind === 'voice');\nconst uns = group.find(r => r.kind === 'unsupported');\nconst media = img || voice || uns || { kind: 'text', fileId: '' };\nreturn [{ json: { chatId: me.chatId, kind: media.kind, fileId: media.fileId || '', text, count: group.length } }];"
      }
    },
